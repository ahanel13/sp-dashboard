{
  "id": "sp-dashboard",
  "name": "Dashboard",
  "version": "{{VERSION}}",
  "description": "{{DESCRIPTION}}",
  "manifestVersion": 1,
  "minSupVersion": "20.0.0",
  "author": "Anthony Hanel",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": false,
  "i18n": {
    "languages": ["en", "es", "fr", "zh"]
  },
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "getAllTags",
    "showSnack",
    "http"
  ],
  "allowedHosts": ["api.github.com"],
  "dataSharing": [
    {
      "recipient": "GitHub",
      "hosts": ["api.github.com"],
      "data": []
    }
  ]
}
